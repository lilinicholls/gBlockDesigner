# Copy this file to ".env" and fill in your own values.
# Never share the real ".env" file with anyone or upload it anywhere.

# Optional. NCBI's BLAST API lists a contact email as a courtesy for
# automated scripts (not a login, and not required for the app to work) -
# it just gives NCBI a way to reach out if something misbehaves, rather
# than blocking it outright. Recommended if you're running this publicly,
# since a public deployment sends more BLAST traffic than one person using
# it locally. Leave blank and the app still works fine.
NCBI_EMAIL=

# Only relevant for local development - leave unset (or "0") everywhere
# else, especially any public deployment. Setting this to 1 turns on
# Flask's interactive debugger, which is a serious security risk if it's
# ever reachable from the internet.
FLASK_DEBUG=0
